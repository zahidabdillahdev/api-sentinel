generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SpecificationSource {
  UPLOAD
  URL
}

enum DiffSeverity {
  BREAKING
  POTENTIALLY_BREAKING
  NON_BREAKING
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
}

enum WebhookDeliveryStatus {
  DELIVERED
  FAILED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  members     Membership[]
  projects    Project[]
  invitations Invitation[]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  passwordHash    String?
  createdAt       DateTime     @default(now())
  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[] @relation("InvitationSender")
  auditEvents     AuditEvent[]  @relation("AuditActor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  invitedById    String
  email          String
  role           ProjectRole  @default(MEMBER)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([expiresAt])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           ProjectRole  @default(MEMBER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime        @default(now())
  retentionDays  Int             @default(30)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  specifications Specification[]
  collections    Collection[]
  environments   Environment[]
  auditEvents    AuditEvent[]

  @@unique([organizationId, slug])
}

model AuditEvent {
  id          String   @id @default(cuid())
  projectId   String
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model Environment {
  id          String              @id @default(cuid())
  projectId   String
  name        String
  baseUrl     String
  createdAt   DateTime            @default(now())
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collections Collection[]
  secrets     EnvironmentSecret[]

  @@unique([projectId, name])
}

model EnvironmentSecret {
  id            String      @id @default(cuid())
  environmentId String
  name          String
  ciphertext    String
  iv            String
  authTag       String
  createdAt     DateTime    @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, name])
}

model Collection {
  id            String         @id @default(cuid())
  projectId     String
  name          String
  createdAt     DateTime       @default(now())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String?
  environment   Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  requests      TestRequest[]
  runs          ExecutionRun[]
  schedules     Schedule[]
  notificationRules NotificationRule[]
}

model NotificationRule {
  id                      String            @id @default(cuid())
  collectionId            String
  name                    String
  endpointOrigin          String
  endpointCiphertext      String
  endpointIv              String
  endpointAuthTag         String
  signingSecretCiphertext String?
  signingSecretIv         String?
  signingSecretAuthTag    String?
  enabled                 Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  collection              Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  deliveries              WebhookDelivery[]

  @@unique([collectionId, name])
}

model Schedule {
  id           String         @id @default(cuid())
  collectionId String
  name         String
  cron         String
  timezone     String         @default("UTC")
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  runs         ExecutionRun[]

  @@unique([collectionId, name])
}

model TestRequest {
  id                  String            @id @default(cuid())
  collectionId        String
  name                String
  method              HttpMethod
  url                 String
  headers             Json?
  body                String?
  expectedHeaderName  String?
  expectedHeaderValue String?
  jsonPath            String?
  expectedJsonValue   String?
  maxDurationMs       Int?
  createdAt           DateTime          @default(now())
  collection          Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assertions          StatusAssertion[]
  results             RequestResult[]
}

model StatusAssertion {
  id             String      @id @default(cuid())
  testRequestId  String
  expectedStatus Int
  testRequest    TestRequest @relation(fields: [testRequestId], references: [id], onDelete: Cascade)
}

model ExecutionRun {
  id           String          @id @default(cuid())
  collectionId String
  status       RunStatus
  createdAt    DateTime        @default(now())
  startedAt    DateTime?
  heartbeatAt  DateTime?
  finishedAt   DateTime?
  error        String?
  scheduleId   String?
  collection   Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  schedule     Schedule?       @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  results      RequestResult[]
  webhookDeliveries WebhookDelivery[]

  @@index([status, heartbeatAt])
  @@index([status, createdAt])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  notificationRuleId String
  executionRunId String
  attempt        Int
  status         WebhookDeliveryStatus
  responseStatus Int?
  durationMs     Int
  error          String?
  createdAt      DateTime              @default(now())
  notificationRule NotificationRule    @relation(fields: [notificationRuleId], references: [id], onDelete: Cascade)
  executionRun   ExecutionRun          @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

  @@unique([notificationRuleId, executionRunId, attempt])
  @@index([executionRunId])
}

model RequestResult {
  id             String       @id @default(cuid())
  executionRunId String
  testRequestId  String
  statusCode     Int?
  durationMs     Int
  error          String?
  passed         Boolean
  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)
  testRequest    TestRequest  @relation(fields: [testRequestId], references: [id], onDelete: Cascade)
}

model Specification {
  id        String                 @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime               @default(now())
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  SpecificationVersion[]
}

model SpecificationVersion {
  id              String              @id @default(cuid())
  specificationId String
  version         Int
  source          SpecificationSource
  sourceUrl       String?
  document        Json
  title           String
  apiVersion      String
  createdAt       DateTime            @default(now())
  specification   Specification       @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  @@unique([specificationId, version])
}
